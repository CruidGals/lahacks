PORT=8080
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- World ID ---
WORLD_ID_APP_ID=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ID_ENVIRONMENT=staging
WORLD_DEVELOPER_API_KEY=

# --- Worldcoin Developer Portal (transaction verification) ---
# Bearer token issued in Developer Portal -> "API keys".
WORLD_DEV_PORTAL_API_KEY=
WORLD_DEV_PORTAL_BASE_URL=https://developer.worldcoin.org

# --- World Chain (mainnet) on-chain config ---
# Chain ID 480. RPC defaults to Alchemy public if blank.
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# WLD ERC-20 contract on World Chain mainnet
WLD_TOKEN_ADDRESS=0x2cFc85d8E48F8EAB294be644d9E25C3030863003
# Backend-controlled vault wallet that receives bounty escrow and pays out / refunds.
# 0x-prefixed 32-byte hex private key. NEVER commit a real key to git.
WORLDCHAIN_VAULT_PRIVATE_KEY=
# Optional override (defaults to address derived from the private key above).
WORLDCHAIN_VAULT_ADDRESS=

# --- Internal / verifier ---
INTERNAL_API_TOKEN=
AI_VERIFY_URL=
SELF_BASE_URL=

# --- Legacy (kept while migrating off Solana) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SET_BOUNTY_WITH_FUNDER=true
SOLANA_FUNDER_SECRET_KEY=
SOLANA_VAULT_SECRET_KEY=
BYPASS_VERIFICATION_FOR_TESTING=false
